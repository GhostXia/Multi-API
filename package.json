{
  "name": "multi-api",
  "version": "1.0.0",
  "description": "一个允许用户保存和切换多个API端点和密钥的后端服务",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "node build.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lowdb": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "bin": {
    "multi-api": "./src/index.js",
    "clean-privacy": "./clean-privacy.js"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/**/*",
      "src/**/*"
    ],
    "targets": [
      "node16-win-x64"
    ]
  }
}
